pkgname=tether
pkgver=0.3.2
pkgrel=1
pkgdesc='Qt NFS and SMB share manager for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/seth-reee/Tether'
license=('MIT')
conflicts=('omamounter')
replaces=('omamounter')
depends=('qt6-base' 'libsecret' 'polkit' 'nfs-utils' 'cifs-utils' 'smbclient')
makedepends=('cmake' 'ninja' 'gcc')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('fd3a865cc620ea98d377fb52f7a2fee5ea33cf6a994ea984dd4071739303bf1a')

build() {
  cmake -S "$srcdir/Tether-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
